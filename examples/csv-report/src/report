#!/bin/sh
# Summarizes sales.csv from the workspace into out/summary.txt.
set -eu

if [ -z "${AIC_WORKSPACE:-}" ]; then
  echo "csv-report: run with --workspace pointing at a folder with sales.csv" >&2
  exit 2
fi

in="$AIC_WORKSPACE/sales.csv"
out="$AIC_WORKSPACE/out/summary.txt"

summary=$(awk -F, 'NR > 1 { total[$1] += $3; count[$1]++ }
  END { for (r in total) printf "%-8s %3d orders %10.2f\n", r, count[r], total[r] }' "$in" | sort)

echo "$summary"
if ! { mkdir -p "$AIC_WORKSPACE/out" && printf '%s\n' "$summary" > "$out"; } 2>/dev/null; then
  echo "csv-report: cannot write $out (grant \$WORKSPACE in the config)" >&2
  exit 1
fi
echo "wrote out/summary.txt"
